{
  "framework": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=900, stale-while-revalidate=1800" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate=7200" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/tips", "destination": "/api/tips" },
    { "source": "/results", "destination": "/api/results" },
    { "source": "/football-tips-today", "destination": "/api/football-tips" },
    { "source": "/nhl-tips-today", "destination": "/api/nhl-tips" },
    { "source": "/nba-tips-today", "destination": "/api/nba-tips" },
    { "source": "/betting-stats", "destination": "/api/stats" }
  ]
}
